#!/bin/sh
# .githooks/pre-commit — 提交前编码闸门
#
# 为什么要有：Windows 上用 PowerShell 的 Set-Content / Add-Content / Out-File 写源码
# 会按 GBK 落盘，中文注释变乱码，tsc/vitest 全绿但 next build 报 invalid utf-8（页面 500）。
# 这条钩子只查「本次暂存的文件」，命中就直接拒绝提交。
#
# 启用（每个克隆执行一次）：
#   git config core.hooksPath .githooks
#
# 临时跳过（真的知道自己在干什么时）：
#   git commit --no-verify

set -e

# 暂存区版本交给检查器（用 git show 取内容，避免工作区改动干扰）
node - "$@" <<'EOF'
const { execFileSync } = require("node:child_process");
const fs = require("node:fs");
const os = require("node:os");
const path = require("node:path");

const EXTS = new Set([".ts",".tsx",".js",".jsx",".mjs",".cjs",".css",".scss",".json",".md",".yml",".yaml",".gradle",".kts",".java",".kt",".xml",".html"]);
const ALLOW = [/^_broken\//, /\/_broken\//, /^test\/xml_writeback\.test\.ts$/, /^AndroidManifest\.xml$/, /^apk\/AndroidManifest\.xml$/, /^package-lock\.json$/];
const SKIP = ["out/", ".next/", "shots/", "test-results/", "assets/www/", "tmpchk/", "tmp-apkchk/"];

const staged = execFileSync("git", ["diff", "--cached", "--name-only", "--diff-filter=ACMR"], { encoding: "utf8" })
  .split("\n").map((s) => s.trim()).filter(Boolean);

const targets = staged.map((f) => f.replace(/\\/g, "/")).filter((f) => {
  if (!EXTS.has(path.extname(f).toLowerCase())) return false;
  if (SKIP.some((p) => f.startsWith(p))) return false;
  if (ALLOW.some((re) => re.test(f))) return false;
  return true;
});
if (targets.length === 0) process.exit(0);

const tmp = fs.mkdtempSync(path.join(os.tmpdir(), "axv-enc-"));
const bad = [];
for (const f of targets) {
  let buf;
  try {
    buf = execFileSync("git", ["show", `:${f}`], { maxBuffer: 32 * 1024 * 1024 });
  } catch {
    continue;
  }
  if (buf.length === 0) continue;
  // 二进制（编译后的 AXML / 图片 / zip）：跳过
  if (buf.length >= 4 && buf[0] === 0x03 && buf[1] === 0x00 && buf[2] === 0x08 && buf[3] === 0x00) continue;
  if (buf.length >= 4 && buf[0] === 0xff && buf[1] === 0xfe) continue;
  if ((buf[0] === 0x89 && buf[1] === 0x50) || (buf[0] === 0xff && buf[1] === 0xd8) || (buf[0] === 0x50 && buf[1] === 0x4b) || (buf[0] === 0x1f && buf[1] === 0x8b)) continue;

  const hasBom = buf.length >= 3 && buf[0] === 0xef && buf[1] === 0xbb && buf[2] === 0xbf;
  const body = hasBom ? buf.subarray(3) : buf;
  try {
    const text = new TextDecoder("utf-8", { fatal: true }).decode(body);
    if (text.includes("\uFFFD")) bad.push([f, "含 U+FFFD（已损坏）"]);
    else if (hasBom) bad.push([f, "UTF-8 带 BOM"]);
  } catch {
    bad.push([f, "不是合法 UTF-8（疑似 GBK）"]);
  }
}
fs.rmSync(tmp, { recursive: true, force: true });

if (bad.length) {
  console.error("\n✗ 编码检查失败，已拒绝提交：");
  for (const [f, why] of bad) console.error(`  ${f} → ${why}`);
  console.error("\n中文文件请用编辑器写（UTF-8 无 BOM），不要用 PowerShell 的 Set-Content / Add-Content / Out-File。");
  console.error("修好后重新 git add；确实无问题可 git commit --no-verify 跳过。\n");
  process.exit(1);
}
process.exit(0);
EOF
